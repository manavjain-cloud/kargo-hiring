# ─────────────────────────────────────────────────────────────────────────────
# Kargo Hiring Intelligence — environment variables
# Copy to .env.local and fill in. Every value here is SERVER-ONLY:
# none of them use the NEXT_PUBLIC_ prefix, so none reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres — Console → your project → Connect → "Pooled connection" string
DATABASE_URL=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional: comma-separated fallbacks when the primary is overloaded (default gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-latest)
GEMINI_FALLBACK_MODELS=

# Resend — optional. Without these, decisions create email DRAFTS only.
RESEND_API_KEY=
# e.g. "Kargo Hiring <hiring@yourdomain.com>" (domain must be verified in Resend),
# or "Kargo Hiring <onboarding@resend.dev>" for testing to your own Resend login email.
# Optional test mode: deliver every approved email to this address (your Resend login email)
# instead of the candidate. Needed while Resend has no verified domain. Leave empty for real sending.
RESEND_TEST_RECIPIENT=
RESEND_FROM_EMAIL=

# Optional: protect the whole app with HTTP Basic auth (recommended when deployed)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
